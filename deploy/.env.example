# Copy to deploy/.env and fill in.  Never commit .env.

# A hostname whose DNS A record points at this server.  Needed for HTTPS.
DOMAIN=menkyo.example.org

# The login for the page.  Make the hash with:
#   docker run --rm caddy:2 caddy hash-password
# and keep the SINGLE QUOTES: the hash contains $ signs.
AUTH_USER=dojo
AUTH_HASH='$2a$14$replace-with-the-hash-you-generated'
